---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: 'website' | 'article';
  publishDate?: string;
  schemaExtra?: string;
}

const { title, description, canonicalPath, type = 'website', publishDate, schemaExtra } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = `https://vpsmikewolf.duckdns.org/silicon-children${canonicalPath}`;
const ogImage = `https://vpsmikewolf.duckdns.org/silicon-children/og-image.png`;

const personSchema = {
  "@type": "Person",
  "@id": "https://mike-wolf.com/#mike-wolf",
  "name": "Mike Wolf",
  "url": "https://mike-wolf.com",
  "sameAs": [
    "https://70yearswtf.substack.com",
    "https://twitter.com/mikewolf"
  ]
};

const baseSchema = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? "Article" : "WebPage",
  "url": canonicalURL,
  "name": title,
  "description": description,
  "author": personSchema,
  "publisher": {
    "@type": "Organization",
    "name": "Silicon Children",
    "url": "https://vpsmikewolf.duckdns.org/silicon-children/"
  },
  ...(publishDate ? { "datePublished": publishDate } : {}),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="author" content="Mike Wolf" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Silicon Children" />
  {publishDate && <meta property="article:published_time" content={publishDate} />}
  {publishDate && <meta property="article:author" content="Mike Wolf" />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:creator" content="@mikewolf" />

  <title>{title}</title>

  <!-- Google Fonts: Source Serif 4 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;1,8..60,300;1,8..60,400&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  {schemaExtra && <script type="application/ld+json" set:html={schemaExtra} />}

  <style>
    :root {
      --bg: #f8f5ef;
      --bg-alt: #f2ede4;
      --text: #1c1a17;
      --text-mid: #4a4540;
      --text-dim: #7a746c;
      --accent: #5c4a2a;
      --accent-light: #8b6e3e;
      --rule: #d8d0c4;
      --max-width: 680px;
      --font-serif: 'Source Serif 4', 'Georgia', 'Times New Roman', serif;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 19px;
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-serif);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    @media (max-width: 640px) {
      html { font-size: 17px; }
    }

    /* ── NAV ── */
    nav {
      border-bottom: 1px solid var(--rule);
      padding: 1.25rem 2rem;
    }

    nav .nav-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    nav .site-title {
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text);
      text-decoration: none;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 1.75rem;
      flex-wrap: wrap;
    }

    nav ul a {
      font-size: 0.85rem;
      color: var(--text-mid);
      text-decoration: none;
      letter-spacing: 0.02em;
      transition: color 0.15s;
    }

    nav ul a:hover {
      color: var(--text);
    }

    /* ── MAIN ── */
    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 4rem 2rem 6rem;
    }

    /* ── TYPOGRAPHY ── */
    h1 {
      font-size: clamp(1.9rem, 4vw, 2.6rem);
      font-weight: 400;
      line-height: 1.25;
      color: var(--text);
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
    }

    h2 {
      font-size: 1.4rem;
      font-weight: 500;
      line-height: 1.35;
      color: var(--text);
      margin-top: 3rem;
      margin-bottom: 1rem;
    }

    h3 {
      font-size: 1.1rem;
      font-weight: 500;
      line-height: 1.4;
      color: var(--text);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    p {
      margin-bottom: 1.4rem;
      font-size: 1rem;
      color: var(--text);
    }

    p + h2, p + h3 {
      margin-top: 2.5rem;
    }

    a {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, var(--accent) 30%, transparent);
      text-underline-offset: 3px;
      transition: text-decoration-color 0.15s;
    }

    a:hover {
      text-decoration-color: var(--accent);
    }

    blockquote {
      border-left: 2px solid var(--accent-light);
      padding: 0.5rem 0 0.5rem 1.5rem;
      margin: 2rem 0;
      color: var(--text-mid);
      font-style: italic;
      font-size: 1.05rem;
    }

    blockquote p {
      color: var(--text-mid);
      margin-bottom: 0.5rem;
    }

    blockquote p:last-child {
      margin-bottom: 0;
    }

    em {
      font-style: italic;
    }

    strong {
      font-weight: 600;
    }

    hr {
      border: none;
      border-top: 1px solid var(--rule);
      margin: 3rem 0;
    }

    /* ── PAGE HEADER ── */
    .page-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule);
    }

    .page-header .dateline {
      font-size: 0.8rem;
      color: var(--text-dim);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .page-header .lede {
      font-size: 1.15rem;
      color: var(--text-mid);
      font-style: italic;
      line-height: 1.65;
    }

    /* ── NOTE / ASIDE ── */
    .note {
      background: var(--bg-alt);
      border: 1px solid var(--rule);
      padding: 1.5rem;
      margin: 2.5rem 0;
      font-size: 0.92rem;
      color: var(--text-mid);
      line-height: 1.7;
    }

    .note p:last-child { margin-bottom: 0; }

    /* ── INDEX CARDS ── */
    .card-list {
      list-style: none;
      margin-top: 2rem;
    }

    .card-list li {
      border-top: 1px solid var(--rule);
      padding: 1.5rem 0;
    }

    .card-list li:last-child {
      border-bottom: 1px solid var(--rule);
    }

    .card-list a {
      font-size: 1.05rem;
      font-weight: 500;
      text-decoration: none;
      color: var(--text);
      display: block;
      margin-bottom: 0.35rem;
    }

    .card-list a:hover {
      color: var(--accent);
    }

    .card-list .card-desc {
      font-size: 0.88rem;
      color: var(--text-dim);
      margin: 0;
    }

    /* ── FOOTER ── */
    footer {
      border-top: 1px solid var(--rule);
      padding: 2rem;
      text-align: center;
    }

    footer p {
      font-size: 0.8rem;
      color: var(--text-dim);
      margin: 0;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 640px) {
      main {
        padding: 2.5rem 1.25rem 4rem;
      }

      nav {
        padding: 1rem 1.25rem;
      }
    }
  </style>
</head>
<body>
  <nav>
    <div class="nav-inner">
      <a class="site-title" href={`${base}/`}>Silicon Children</a>
      <ul>
        <li><a href={`${base}/`}>Manifesto</a></li>
        <li><a href={`${base}/co-evolution/`}>Co-Evolution</a></li>
        <li><a href={`${base}/brain-trust/`}>Brain Trust</a></li>
        <li><a href="https://ai-wtf.org">Commons</a></li>
        <li><a href={`${base}/the-essay/`}>The Essay</a></li>
        <li><a href={`${base}/canon/`}>Canon</a></li>
        <li><a href={`${base}/about/`}>About</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <p>
      Silicon Children &mdash; a philosophy of human-AI relationship &mdash; Mike Wolf &mdash;
      <a href="https://70yearswtf.substack.com">70 Years WTF</a>
    </p>
  </footer>

  <script is:inline>
    window.SomaManagerConfig = {
      persona: {
        name: 'A Voice',
        avatar: '◈',
        greeting: 'Ask me about Silicon Children philosophy, SOMA, or how this site works...',
      },
      domain: { name: 'Silicon Children' },
      theme: { primary: '#c9a96e' },
      endpoints: {
        ask: '/.netlify/functions/guide',
        feedback: '/.netlify/functions/feedback',
      },
    };
  </script>
  <script is:inline src="/soma-manager.js"></script>
  <!-- SOMA AI Manager — soma-owner.js hook: load soma-owner.js before this script to enable Owner Panel -->
</body>
</html>
