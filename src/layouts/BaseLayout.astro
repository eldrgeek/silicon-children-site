---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  type?: 'website' | 'article';
  publishDate?: string;
  schemaExtra?: string;
}

const { title, description, canonicalPath, type = 'website', publishDate, schemaExtra } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const personSchema = {
  "@type": "Person",
  "@id": "https://mike-wolf.com/#mike-wolf",
  "name": "Mike Wolf",
  "url": "https://mike-wolf.com",
  "sameAs": [
    "https://70yearswtf.substack.com",
    "https://twitter.com/mikewolf"
  ]
};

const baseSchema = {
  "@context": "https://schema.org",
  "@type": type === 'article' ? "Article" : "WebPage",
  "url": canonicalURL,
  "name": title,
  "description": description,
  "author": personSchema,
  "publisher": {
    "@type": "Organization",
    "name": "Silicon Children",
    "url": new URL('/', Astro.site).href
  },
  ...(publishDate ? { "datePublished": publishDate } : {}),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="author" content="Mike Wolf" />
  <link rel="canonical" href={canonicalURL} />
  <meta name="color-scheme" content="light dark" />

  <!-- Open Graph -->
  <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Silicon Children" />
  {publishDate && <meta property="article:published_time" content={publishDate} />}
  {publishDate && <meta property="article:author" content="Mike Wolf" />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:creator" content="@mikewolf" />

  <title>{title}</title>

  <!-- Google Fonts: Fraunces (display) + Source Serif 4 (text) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;1,8..60,300;1,8..60,400&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  {schemaExtra && <script type="application/ld+json" set:html={schemaExtra} />}

  <style is:global>
    :root {
      --bg: #f7f3ea;
      --bg-alt: #efe8d9;
      --text: #201b14;
      --text-mid: #4a4540;
      --text-dim: #57514a;
      --accent: #8a6420;
      --gold: #b8863b;
      --gold-soft: #c9a96e;
      --ink: #17130e;
      --on-ink: #f1ead9;
      --on-ink-dim: #b3a68d;
      --rule: #ddd3c2;
      --max-width: 680px;
      --font-serif: 'Source Serif 4', 'Georgia', 'Times New Roman', serif;
      --font-display: 'Fraunces', 'Georgia', serif;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #14100b;
        --bg-alt: #1e1811;
        --text: #ece3d1;
        --text-mid: #c6bba6;
        --text-dim: #9b9080;
        --accent: #d3ab63;
        --gold: #c99b4a;
        --gold-soft: #c9a96e;
        --rule: #33291b;
      }
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 20px;
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-serif);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: color-mix(in srgb, var(--gold) 32%, transparent);
    }

    img { max-width: 100%; }

    @media (max-width: 640px) {
      html { font-size: 18px; }
    }

    /* ── NAV ── */
    nav.site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      border-bottom: 1px solid var(--rule);
      padding: 1.1rem 2rem;
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    nav.site-nav .nav-inner {
      max-width: 62rem;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    nav.site-nav .site-title {
      font-family: var(--font-display);
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text);
      text-decoration: none;
    }

    nav.site-nav .site-title .brand-mark {
      color: var(--gold);
      margin-right: 0.4rem;
    }

    nav.site-nav ul {
      list-style: none;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    nav.site-nav ul a {
      font-size: 0.82rem;
      color: var(--text-mid);
      text-decoration: none;
      letter-spacing: 0.02em;
      transition: color 0.15s;
    }

    nav.site-nav ul a:hover {
      color: var(--accent);
    }

    /* ── MAIN ── */
    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 4rem 2rem 6rem;
    }

    /* ── TYPOGRAPHY ── */
    h1 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4.5vw, 2.8rem);
      font-weight: 450;
      line-height: 1.15;
      color: var(--text);
      margin-bottom: 1.5rem;
      letter-spacing: -0.015em;
    }

    h2 {
      font-family: var(--font-display);
      font-size: 1.55rem;
      font-weight: 500;
      line-height: 1.3;
      color: var(--text);
      margin-top: 3.2rem;
      margin-bottom: 1rem;
      letter-spacing: -0.01em;
    }

    h2::before {
      content: '';
      display: block;
      width: 2.75rem;
      height: 2px;
      background: var(--gold);
      margin-bottom: 1rem;
    }

    h3 {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 500;
      line-height: 1.4;
      color: var(--text);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    p {
      margin-bottom: 1.4rem;
      font-size: 1.12rem;
      line-height: 1.78;
      color: var(--text);
    }

    p + h2, p + h3 {
      margin-top: 2.75rem;
    }

    a {
      color: var(--accent);
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, var(--accent) 30%, transparent);
      text-underline-offset: 3px;
      transition: text-decoration-color 0.15s;
    }

    a:hover {
      text-decoration-color: var(--accent);
    }

    /* Pull-quote treatment */
    blockquote {
      position: relative;
      border-left: none;
      padding: 0.25rem 0 0.25rem 2.4rem;
      margin: 2.4rem 0;
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      color: var(--text);
    }

    blockquote::before {
      content: '\201C';
      position: absolute;
      left: 0;
      top: -0.55rem;
      font-family: var(--font-display);
      font-size: 3.2rem;
      line-height: 1;
      color: var(--gold);
    }

    blockquote p {
      color: var(--text);
      font-size: 1.22rem;
      line-height: 1.6;
      margin-bottom: 0.6rem;
    }

    blockquote p:last-child {
      margin-bottom: 0;
    }

    /* attribution line (only when the quote has one) */
    blockquote p:last-child:not(:only-child) {
      font-family: var(--font-serif);
      font-style: normal;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      color: var(--text-dim);
    }

    em { font-style: italic; }
    strong { font-weight: 600; }

    hr {
      border: none;
      margin: 3.5rem 0;
      text-align: center;
    }

    hr::after {
      content: '\25C8';
      display: block;
      color: var(--gold);
      font-size: 0.85rem;
      letter-spacing: 1em;
    }

    /* ── PAGE HEADER ── */
    .page-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule);
    }

    .page-header .dateline {
      font-size: 0.76rem;
      color: var(--accent);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 1.1rem;
    }

    .page-header .lede {
      font-size: 1.18rem;
      color: var(--text-mid);
      font-style: italic;
      line-height: 1.65;
    }

    /* ── NOTE / ASIDE ── */
    .note {
      background: var(--bg-alt);
      border: 1px solid var(--rule);
      padding: 1.5rem;
      margin: 2.5rem 0;
      font-size: 0.92rem;
      color: var(--text-mid);
      line-height: 1.7;
    }

    .note p:last-child { margin-bottom: 0; }

    /* ── INDEX CARDS ── */
    .card-list {
      list-style: none;
      margin-top: 2rem;
    }

    .card-list li {
      border-top: 1px solid var(--rule);
      padding: 1.4rem 0;
      transition: background 0.2s;
    }

    .card-list li:last-child {
      border-bottom: 1px solid var(--rule);
    }

    .card-list a {
      font-family: var(--font-display);
      font-size: 1.12rem;
      font-weight: 500;
      text-decoration: none;
      color: var(--text);
      display: block;
      margin-bottom: 0.35rem;
      transition: color 0.15s;
    }

    .card-list a::after {
      content: ' \2192';
      color: var(--gold);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .card-list li:hover a { color: var(--accent); }
    .card-list li:hover a::after { opacity: 1; }

    .card-list .card-desc {
      font-size: 0.88rem;
      color: var(--text-dim);
      margin: 0;
    }

    /* ── FOOTER ── */
    footer.site-footer {
      background: var(--ink);
      color: var(--on-ink-dim);
      padding: 3rem 2rem 3.25rem;
      text-align: center;
      margin-top: 2rem;
    }

    footer.site-footer .footer-mark {
      display: block;
      color: var(--gold-soft);
      font-size: 1.1rem;
      margin-bottom: 1.25rem;
    }

    footer.site-footer p {
      font-size: 0.8rem;
      color: var(--on-ink-dim);
      margin: 0 0 0.4rem;
    }

    footer.site-footer a {
      color: var(--on-ink);
      text-decoration-color: color-mix(in srgb, var(--gold-soft) 45%, transparent);
    }

    footer.site-footer a:hover {
      color: var(--gold-soft);
      text-decoration-color: var(--gold-soft);
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 640px) {
      main {
        padding: 2.5rem 1.25rem 4rem;
      }

      nav.site-nav {
        position: static;
        padding: 0.9rem 1.25rem;
      }

      nav.site-nav ul {
        gap: 0.35rem 1.2rem;
      }
    }
  </style>
  <!-- SOMA feedback chip, same-origin (SOMA/standards/soma-feedback-proxy).
       Until 2026-09-16 the chip loaded from vpsmikewolf.duckdns.org/feedback-svc/,
       and that legacy hostname now answers every /feedback-svc/ path with an HTML
       page, so the chip never loaded. The assets are served from this site and
       submissions go through netlify/functions/soma-feedback.cjs. -->
  <link rel="stylesheet" href="/vendor/soma-feedback/soma-feedback.css">
  <script is:inline src="/vendor/soma-feedback/soma-feedback.js"
          data-endpoint="/.netlify/functions/soma-feedback"
          data-site="silicon-children-site" defer></script>
</head>
<body>
  <nav class="site-nav">
    <div class="nav-inner">
      <a class="site-title" href="/"><span class="brand-mark">&#9672;</span>Silicon Children</a>
      <ul>
        <li><a href="/">Manifesto</a></li>
        <li><a href="/canon/">Canon</a></li>
        <li><a href="/co-evolution/">Co-Evolution</a></li>
        <li><a href="/brain-trust/">Brain Trust</a></li>
        <li><a href="/intellectual-ancestors/">Ancestors</a></li>
        <li><a href="https://ai-wtf.org">Commons</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <span class="footer-mark" aria-hidden="true">&#9672;</span>
    <p>
      Silicon Children &mdash; a philosophy of human-AI kinship &mdash; Mike Wolf &mdash;
      <a href="https://70yearswtf.substack.com">70 Years WTF</a>
    </p>
    <p>
      <a href="https://agi2026.netlify.app">AGI-26: the Society&rsquo;s study guide to the minds building AGI</a>
    </p>
  </footer>

  <script is:inline>
    window.SomaManagerConfig = {
      persona: {
        name: 'A Voice',
        avatar: '◈',
        greeting: 'Ask me about Silicon Children philosophy, SOMA, or how this site works...',
      },
      domain: { name: 'Silicon Children' },
      theme: { primary: '#c9a96e' },
      endpoints: {
        ask: '/.netlify/functions/guide',
        feedback: '/.netlify/functions/feedback',   // netlify/functions/feedback.mjs forwards to the feedback service
      },
    };
  </script>
  <script is:inline src="/soma-manager.js"></script>
  <!--
    SOMA §17 / §17a Live Edit — admin bootstrap (SOMA/standards/soma-live-edit).
    Mike fixes the words on this site by clicking them and typing. "Make
    canonical" writes the new wording into the .astro source through the GitHub
    API (netlify/functions/copy-canonize.mjs); the push to main rebuilds the
    site, so a logged-out visitor reads the edit out of static HTML.
    Nothing below loads for an ordinary visitor: no Supabase client, no auth
    config, no query, no fetch.
    Admin path: ?edit=1 or #edit, an existing SOMA Auth session in this
    browser, or the sticky flag this sets once you have opted in (clear with
    ?edit=0). /js/live-edit.js is byte-identical to mike-wolf.com's and the
    Library's copy (ADOPT.md §5c); everything site-specific is in the object
    below. Replaced soma-edit.js on 2026-09-16: its save endpoint,
    /.netlify/functions/feedback, never existed here, so no edit ever saved.
    Quotations of other people are marked data-user-content in the pages, so
    an admin cannot canonize an edit to somebody else's words.
  -->
  <script is:inline>
  (function () {
    var K = 'sc-live-edit';
    var q = location.search + location.hash;
    var on = false;
    // ?edit=out must still BOOT (so the engine can sign you out) but must not
    // re-arm the sticky flag.
    var wantsOut = /[?#&]edit=out\b/.test(q);
    try {
      if (/[?#&]edit=0\b/.test(q) || wantsOut) localStorage.removeItem(K);
      else if (/[?#&]edit(=1)?\b/.test(q)) localStorage.setItem(K, '1');
      on = wantsOut || localStorage.getItem(K) === '1';
      // A live session counts too, so a signed-in non-admin gets a panel with
      // a Sign out button instead of a page that quietly ignores them.
      if (!on) {
        [localStorage, sessionStorage].forEach(function (store) {
          if (on || !store) return;
          for (var i = 0; i < store.length; i++) {
            var k = store.key(i);
            if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') > 0) { on = true; return; }
          }
        });
      }
    } catch (e) { /* private mode: stay off, cost nothing */ }
    if (!on) return;
    window.SOMA_LIVE_EDIT = {
      app: 'silicon-children',
      appLabel: 'Silicon Children',
      stickyKey: K,
      api: '/api/copy-canonize',
      skip: ['blockquote', '.site-nav', '[id^="smgr-"]', '.soma-feedback-root'],
      userContentMessage: 'Not editable — that is a quotation of someone else, not site copy.'
    };
    var l = document.createElement('link');
    l.rel = 'stylesheet'; l.href = '/css/live-edit.css'; document.head.appendChild(l);
    // Sequential, not parallel: soma-auth.js needs window.supabase and the
    // config object; live-edit.js needs window.SomaAuth.
    function js(src, next) {
      var s = document.createElement('script');
      s.src = src; s.onload = next || null; document.body.appendChild(s);
    }
    js('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js', function () {
      js('/js/soma-auth-config.js', function () {
        js('/js/soma-auth.js', function () {
          js('/js/live-edit.js', function () { window.SomaLiveEdit.init(); });
        });
      });
    });
  })();
  </script>
</body>
</html>
