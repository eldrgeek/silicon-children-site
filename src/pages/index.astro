<script>
  // Tour lightbox — opens only on explicit click; never autoplays on page load.
  (function () {
    var box = document.getElementById('tour-lightbox');
    var vid = document.getElementById('tour-video');
    if (!box || !vid) return;
    var open = function () {
      box.showModal();
      vid.play().catch(function () {});
    };
    document.getElementById('tour-open').addEventListener('click', open);
    document.getElementById('tour-open-2').addEventListener('click', open);
    var heroBtn = document.getElementById('tour-open-hero');
    if (heroBtn) heroBtn.addEventListener('click', open);
    document.getElementById('tour-close').addEventListener('click', function () {
      box.close();
    });
    box.addEventListener('click', function (e) {
      if (e.target === box) box.close();
    });
    box.addEventListener('close', function () {
      vid.pause();
    });
  })();
</script>
