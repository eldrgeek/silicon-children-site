const ancestorsSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Intellectual Ancestors — Silicon Children",
  "description": "The thinkers who arrived at the human-AI kinship frame before or alongside Mike Wolf. Moravec, Kelly, Deutsch, Bach, Hofstadter.",
  "author": {
    "@type": "Person",
    "name": "Mike Wolf",
    "url": "https://mike-wolf.com"
  },
  "about": [
    {"@type": "Person", "name": "Hans Moravec"},
    {"@type": "Person", "name": "Kevin Kelly"},
